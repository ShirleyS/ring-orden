{
  "openapi": "3.1.0",
  "info": {
    "title": "Ring Orden ElevenLabs server tools",
    "version": "0.1.0",
    "description": "Configure AGENT_TOOL_SECRET and AGENT_MERCHANT_ID server-side. Never accept merchant_id from the caller. Replace BASE_URL in your ElevenLabs integration with the deployed API origin. Header Authorization: Bearer <AGENT_TOOL_SECRET>. The secret must never be spoken or exposed to browser clients."
  },
  "servers": [
    {
      "url": "https://YOUR_RING_ORDEN_HOST"
    }
  ],
  "components": {
    "securitySchemes": {
      "agentBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/api/tools/create_session": {
      "post": {
        "operationId": "create_session",
        "description": "Create a merchant-scoped ordering session. Reuse the same request_id and body for retries. Recover a known session_id with get_order_state; conversation-ID lookup is not supported.",
        "security": [
          {
            "agentBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 120,
                    "description": "Customer name when supplied by the caller."
                  },
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+\\d{8,15}$",
                    "description": "Customer phone in international E.164 format, obtained from trusted caller metadata or explicitly provided by the customer."
                  },
                  "request_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S",
                    "description": "Stable unique ID for starting this call. Reuse the same ID and body if the request is retried; never generate a new ID for a retry."
                  }
                },
                "required": [
                  "request_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Previously saved result for an identical request_id and body"
          },
          "201": {
            "description": "New authoritative merchant-scoped ordering session"
          },
          "401": {
            "description": "Invalid server agent credential"
          },
          "404": {
            "description": "Session not found for configured merchant"
          },
          "409": {
            "description": "Operation cannot be applied to current order"
          }
        }
      }
    },
    "/api/tools/get_business_info": {
      "post": {
        "operationId": "get_business_info",
        "description": "Read authoritative merchant information, hours and ordering rules.",
        "security": [
          {
            "agentBearer": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative merchant-scoped tool result"
          },
          "401": {
            "description": "Invalid server agent credential"
          },
          "404": {
            "description": "Session not found for configured merchant"
          },
          "409": {
            "description": "Operation cannot be applied to current order"
          }
        }
      }
    },
