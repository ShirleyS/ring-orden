              "schema": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string",
                    "dynamic_variable": "ring_orden_session_id"
                  },
                  "preference_key": {
                    "type": "string",
                    "description": "A bounded preference key, for example milk or sweetness."
                  },
                  "preference_value": {
                    "type": "string",
                    "description": "The customer's confirmed preference, not an inferred assumption."
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "permanent"
                    ]
                  },
                  "confirmed": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "session_id",
                  "preference_key",
