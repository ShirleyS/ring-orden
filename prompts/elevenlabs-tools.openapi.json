    "/api/tools/process_order_turn": {
      "post": {
        "operationId": "process_order_turn",
        "description": "Interpret the exact caller words and persist validated transaction operations.",
        "security": [
          {
            "agentBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string"
                  },
                  "utterance": {
                    "type": "string",
                    "maxLength": 1500,
                    "minLength": 1
                  },
                  "request_id": {
                    "type": "string",
                    "description": "Unique ID for this customer turn; reuse only when retrying the same turn.",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "session_id",
                  "utterance",
                  "request_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative merchant-scoped tool result"
          },
          "401": {
            "description": "Invalid server agent credential"
          },
          "404": {
            "description": "Session not found for configured merchant"
          },
          "409": {
            "description": "Operation cannot be applied to current order"
          }
        }
      }
    },
    "/api/tools/confirm_order": {
      "post": {
        "operationId": "confirm_order",
