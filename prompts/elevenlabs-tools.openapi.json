    "/api/tools/update_customer_preference": {
      "post": {
        "operationId": "update_customer_preference",
        "summary": "Save a permanent preference only after the caller explicitly confirms; verified identity is required. One-time order instructions belong in process_order_turn.",
        "security": [
          {
            "bearerAuth": []
