                      "receipt",
                      "recovery"
                    ]
                  },
                  "consent": {
                    "type": "boolean"
                  },
                  "utterance": {
                    "type": "string",
                    "description": "The customer's exact words agreeing to or declining this specific follow-up."
                  }
                },
                "required": [
                  "session_id",
                  "purpose",
                  "consent",
                  "utterance"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded authoritative result; check status and verification."
          },
          "401": {
            "description": "Invalid authentication"
          },
          "403": {
            "description": "Verification required"
          }
        }
      }
    },
