    "/api/tools/set_customer_followup_consent": {
      "post": {
        "operationId": "set_customer_followup_consent",
        "summary": "Record explicit permission for a WhatsApp receipt when completed, or a ten-minute recovery link if this call ends with an unfinished order. This schedules permission; it does not claim a message was sent.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string",
                    "dynamic_variable": "ring_orden_session_id"
                  },
