{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ring-orden.dev/schemas/operation.schema.json",
  "title": "Ring Orden transaction operation",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "add_item"
        },
        "catalog_item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "modifier_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "maxItems": 50
        }
      },
      "required": [
        "action",
        "catalog_item_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "remove_item"
        },
        "target": {
          "type": "object",
          "properties": {
            "line_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "line_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "target"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "modify_item"
        },
        "target": {
          "type": "object",
          "properties": {
            "line_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "line_id"
          ],
          "additionalProperties": false
        },
        "changes": {
          "type": "object",
          "properties": {
            "catalog_item_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "modifier_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "maxItems": 50
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "action",
        "target",
        "changes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "change_quantity"
        },
        "target": {
          "type": "object",
          "properties": {
            "line_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "line_id"
          ],
          "additionalProperties": false
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "action",
        "target",
        "quantity"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "add_modifier"
        },
        "target": {
          "type": "object",
          "properties": {
            "line_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "line_id"
          ],
          "additionalProperties": false
        },
        "modifier_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "action",
        "target",
        "modifier_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "remove_modifier"
        },
        "target": {
          "type": "object",
          "properties": {
            "line_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "line_id"
          ],
          "additionalProperties": false
        },
        "modifier_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "action",
        "target",
        "modifier_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "set_customer_name"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "action",
        "name"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "set_fulfillment"
        },
        "fulfillment_type": {
          "enum": [
            "pickup",
            "dine_in",
            "delivery"
          ]
        },
        "delivery_address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "action",
        "fulfillment_type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "set_pickup_time"
        },
        "scheduled_for": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action",
        "scheduled_for"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "add_note"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "action",
        "note"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "confirm_order"
        },
        "confirmed": {
          "const": true
        }
      },
      "required": [
        "action",
        "confirmed"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "cancel_order"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "request_clarification"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "action",
        "question"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "escalate_issue"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
