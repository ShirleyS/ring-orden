# Running app: private Sites D1 persistence; true means clearly labeled sample data.
DEMO_MODE=true
# Leave unset on Sites (trusted *.chatgpt.site host autodetection). Set false on standalone API hosts.
# Set true ONLY behind a proxy that strips untrusted oai-* headers and injects verified identity.
TRUST_SITES_HEADERS=
# Public origin for payment return pages in production; local app origin in development.
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace_with_at_least_32_random_characters

# MojoAuth verified JWT/JWKS configuration from your tenant's OIDC discovery document.
MOJOAUTH_JWKS_URL=
MOJOAUTH_ISSUER=
MOJOAUTH_AUDIENCE=
# Hosted login: client ID is MOJOAUTH_AUDIENCE; this secret stays server-only.
# Register https://YOUR-MERCHANT-HOST/api/auth/mojo/callback in MojoAuth.
MOJOAUTH_CLIENT_SECRET=

# Server-only models; browser gets only metadata, never keys.
DEEPSEEK_API_KEY=
# Optional BYO configuration is saved through PATCH /api/settings model section.
# provider: deepseek, qwen, ollama, vllm, sglang, generic

# ElevenLabs: signed conversation URLs; configure the included server tools.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
AGENT_TOOL_SECRET=replace_with_a_random_shared_secret
# Resolve the authenticated merchant ID from GET /api/bootstrap, never caller input.
AGENT_MERCHANT_ID=

# Twilio: use an approved WhatsApp sender, or sandbox with opted-in test recipients.
TWILIO_ACCOUNT_SID=
# Prefer a restricted API key with Messaging read/write permissions over the account Auth Token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Legacy fallback; leave unset when using a restricted API key.
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Required for business-initiated conversations outside the service window.
TWILIO_WHATSAPP_TEMPLATE_SID=
# Dedicated receipt template variables: 1 reference, 2 items, 3 total/currency,
# 4 full Lovable receipt URL, 5 payment status. Do not reuse checkout template.
TWILIO_RECEIPT_TEMPLATE_SID=

# Stripe TEST MODE ONLY. Both checkout and signed webhooks are required.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Square: sandbox by default; map canonical catalog and modifier IDs in POS settings.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# Import n8n/*.json and set these variables in n8n too.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Supabase repository: apply all database/supabase/migrations in order first.
# Set URL and SERVER_SECRET together to switch from D1. Keys remain server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVER_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# One-time Sites D1 import only. Keep false on fresh deployments/Netlify.
# After verifying the completed import, remove this flag and redeploy.
SUPABASE_MIGRATE_D1=false

# Exact HTTPS origin of the Lovable customer app; no path, query or fragment.
# Customer order links remain unavailable until this is configured.
CUSTOMER_APP_ORIGIN=
